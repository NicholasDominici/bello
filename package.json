{
  "name": "bell-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "predev": "pnpm setup:runtime",
    "dev": "next dev --hostname 127.0.0.1 --port 4320",
    "prebuild": "pnpm setup:runtime",
    "build": "eve build --skip-sandbox-prewarm && next build",
    "start": "next start --hostname 127.0.0.1 --port 4320",
    "pretest": "pnpm setup:runtime",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "setup:runtime": "pnpm --filter browsie build:library",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "check:workspace": "pnpm --filter browsie check && pnpm check",
    "baselayer:mint": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/mint-baselayer-credential.mjs",
    "test:retirement:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-session-retirement.mjs"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@ai-sdk/openai": "4.0.46",
    "@browserbasehq/sdk": "2.18.0",
    "@browserbasehq/stagehand": "4.3.0",
    "@vercel/blob": "^2.8.2",
    "ai": "7.0.137",
    "browsie": "workspace:*",
    "eve": "0.79.1",
    "next": "16.3.8",
    "playwright-core": "1.62.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/browserbase/bell-stack.git"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "eve>undici": "8.10.2"
    }
  }
}
